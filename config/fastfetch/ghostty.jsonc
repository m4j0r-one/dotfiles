{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "kitty-direct",
        "source": "/home/YOUR_USERNAME/.local/share/m4j0r.one/terminal-logo.png",
        "width": 16,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3,
        },
        "printRemaining": false,
    },

    "display": {
        "separator": "  ",
        "brightColor": true,
        "color": {
            "keys": "cyan",
            "output": "white",
            "separator": "magenta",
        },
        "key": {
            "width": 13,
            "type": "string",
        },
    },

    "modules": [
        "break",

        {
            "type": "custom",
            "format": "\u001b[1;38;2;0;229;255mm4j0r.one\u001b[0m  \u001b[1;38;2;255;43;214m// GHOSTTY\u001b[0m",
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;0;229;255m──────────────────────────────\u001b[0m",
        },

        {
            "type": "os",
            "key": "󰣇  System",
        },
        {
            "type": "kernel",
            "key": "󰒋  Kernel",
        },
        {
            "type": "uptime",
            "key": "󰅐  Uptime",
        },
        {
            "type": "packages",
            "key": "󰏖  Pakete",
        },
        {
            "type": "shell",
            "key": "  Shell",
        },
        {
            "type": "wm",
            "key": "  Desktop",
        },
        {
            "type": "terminal",
            "key": "  Terminal",
        },
        {
            "type": "cpu",
            "key": "  CPU",
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU",
        },
        {
            "type": "memory",
            "key": "  RAM",
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "󰋊  Root",
        },
        {
            "type": "localip",
            "key": "󰩟  Netzwerk",
        },
    ],
}
