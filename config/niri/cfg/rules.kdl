// BEGIN m4j0r Thunderbird Neon Glass
window-rule {
    match app-id=r#"^org\.mozilla\.Thunderbird$"#

    draw-border-with-background false

    // Höher als bei Firefox, damit Mailtexte gut lesbar bleiben.
    opacity 0.92

    geometry-corner-radius 16
    clip-to-geometry true

    background-effect {
        blur true
        xray true
        noise 0.018
        saturation 1.30
    }

    popups {
        geometry-corner-radius 13
        opacity 0.98

        background-effect {
            blur true
            xray true
            noise 0.014
            saturation 1.24
        }
    }
}
// END m4j0r Thunderbird Neon Glass

// BEGIN m4j0r Discord Neon Glass
window-rule {
    match app-id=r#"^discord$"#

    draw-border-with-background false

    // Transparenz – guter Mittelweg zwischen Glas und Lesbarkeit
    opacity 0.90

    geometry-corner-radius 16
    clip-to-geometry true

    background-effect {
        blur true
        xray true
        noise 0.018
        saturation 1.30
    }
}
// END m4j0r Discord Neon Glass

// Rimworld
window-rule {
    match app-id=r#"^gamescope$"#

    open-on-output "DP-1"
}

layer-rule {
    match namespace="^noctalia-(background|launcher-overlay|dock)-.*$"

    background-effect {
        xray false
    }
}
